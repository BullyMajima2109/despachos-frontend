# ============================================================
# .env - Variables de entorno del Frontend Despachos
# IMPORTANTE: NO subir este archivo al repositorio con datos reales
# Copiar como .env y completar con los valores reales
# ============================================================

# URL del Backend (IP privada de la EC2 backend en AWS)
# En local: http://localhost:8081
# En EC2:   http://<IP-PRIVADA-EC2-BACKEND>:8081
VITE_API_URL=http://localhost:8081
